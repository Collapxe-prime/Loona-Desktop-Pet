# Python, environments and caches
__pycache__/
*.py[cod]
.venv/
venv/
.build-venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Local editor, machine and application state
.idea/
.vscode/
.env
.env.*
!.env.example
/settings.json
/settings.json.tmp
*.log
*.log.*
Thumbs.db
Desktop.ini
.DS_Store

# Build products, archives and development scratch directories
/build/
/dist/
/release/
/releases/
/backups/
/outputs/
/work/
/tmp/
*.tmp
*.bak
*.zip
*.tar.gz

# Only runtime assets belong to the application repository.
/assets/*
!/assets/Loona.png
!/assets/revamp/
!/assets/animations/
!/assets/petting-smile/
/assets/revamp/*
!/assets/revamp/manifest.json
!/assets/revamp/quality-profile.json
!/assets/revamp/hq/
!/assets/revamp/idle/
!/assets/revamp/running-right/
!/assets/revamp/running-left/
!/assets/revamp/waving/
!/assets/revamp/jumping/
!/assets/revamp/failed/
!/assets/revamp/waiting/
!/assets/revamp/running/
!/assets/revamp/review/
!/assets/revamp/sitting/
!/assets/revamp/falling/
!/assets/revamp/slipping/
!/assets/revamp/balancing/
