!/assets/revamp/walking-left/
!/assets/revamp/look/
/assets/revamp/**/*.gif
/assets/revamp/**/*-contact.png
/assets/revamp/**/*-sheet.png
/assets/revamp/**/sources/
/assets/animations/*
!/assets/animations/sitting/
!/assets/animations/falling/
!/assets/animations/slipping/
!/assets/animations/balancing/
/assets/petting-smile/*
